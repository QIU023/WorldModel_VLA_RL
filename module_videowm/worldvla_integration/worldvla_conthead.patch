     return g_image
+
+
+def get_action_Chameleon_cont_awm_ck(model, cur_img, task_description, item_processor,
+                                     his_img, his_action, his_type, action_steps, n_chunks=10):
+    """Continuous-action-head decode (OFT/VITA style): build the img_only prompt, then autoregressively
+    append action_start(10004), forward (training branch computes model._cont_preds at all positions),
+    read the cont head at the just-appended action_start -> 7-dim NORMALIZED action; discretize it back
+    to dim tokens + action_end(15004) to keep the context faithful, repeat n_chunks. Returns list of
+    [7] normalized action tensors (eval unnorm_min_max handles denorm). Single-GPU eval -> no FSDP gather
+    issue; model._cont_preds is read directly."""
+    import numpy as _np, torch as _t
+    # prompt (mirror the dis 2h_1a_img_only / 1h / 4h variants; action:[])
+    if his_type == "2h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>" * len(his_img[-1:]) + "<|image|>"
+        imgs = his_img[-1:] + [cur_img]
+    elif his_type == "1h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>"
+        imgs = [cur_img]
+    elif his_type == "4h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>" * len(his_img[-3:]) + "<|image|>"
+        imgs = his_img[-3:] + [cur_img]
+    else:
+        raise ValueError(f"cont head decode: unsupported his_type {his_type}")
+    conv = {"conversations": [{"from": "human", "value": val}], "image": imgs, "action": []}
+    tokens = item_processor.process_item(conv, training_mode=False)
+    seq = list(tokens)
+    ACT_START = item_processor.token2id(item_processor.action_start_token)   # 10004
+    ACT_END = item_processor.token2id(item_processor.action_end_token)       # 15004
+    bins = item_processor.bins
+    actions = []
+    for _k in range(n_chunks):
+        seq = seq + [ACT_START]
+        inp = _t.tensor([seq], dtype=_t.int64, device=model.device)
+        lab = _t.full_like(inp, -100)
+        with _t.no_grad():
+            model(input_ids=inp, labels=lab, output_hidden_states=True, training=True, att_mask=True)
+        cp = model._cont_preds[0, -1].float().cpu().numpy()       # [7] at the action_start
+        arm = _np.clip(cp[:6], -1.0, 1.0)
+        grip = 2.0 * (1.0 / (1.0 + _np.exp(-cp[6]))) - 1.0        # gripper: BCE logit -> prob -> [-1,1]
+        act_norm = _np.concatenate([arm, [grip]]).astype(_np.float32)
+        actions.append(_t.tensor(act_norm))
+        dims = (_np.digitize(act_norm, bins) + ACT_START + 1).tolist()   # same discretization as process_action
+        seq = seq + dims + [ACT_END]
+    return actions
