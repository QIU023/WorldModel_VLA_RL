+def get_action_Chameleon_cont_awm_ck(model, cur_img, task_description, item_processor,
+                                     his_img, his_action, his_type, action_steps, n_chunks=10):
+    """Continuous-action-head decode (OFT/VITA style): build the img_only prompt, then autoregressively
+    append action_start(10004), forward (training branch computes model._cont_preds at all positions),
+    read the cont head at the just-appended action_start -> 7-dim NORMALIZED action; discretize it back
+    to dim tokens + action_end(15004) to keep the context faithful, repeat n_chunks. Returns list of
+    [7] normalized action tensors (eval unnorm_min_max handles denorm). Single-GPU eval -> no FSDP gather
+    issue; model._cont_preds is read directly."""
+    import numpy as _np, torch as _t
+    # prompt (mirror the dis 2h_1a_img_only / 1h / 4h variants; action:[])
+    if his_type == "2h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>" * len(his_img[-1:]) + "<|image|>"
+        imgs = his_img[-1:] + [cur_img]
+    elif his_type == "1h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>"
+        imgs = [cur_img]
+    elif his_type == "4h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>" * len(his_img[-3:]) + "<|image|>"
+        imgs = his_img[-3:] + [cur_img]
+    else:
+        raise ValueError(f"cont head decode: unsupported his_type {his_type}")
+    conv = {"conversations": [{"from": "human", "value": val}], "image": imgs, "action": []}
+    tokens = item_processor.process_item(conv, training_mode=False)
+    seq = list(tokens)
+    ACT_START = item_processor.token2id(item_processor.action_start_token)   # 10004
+    ACT_END = item_processor.token2id(item_processor.action_end_token)       # 15004
+    bins = item_processor.bins
+    import os as _os
+    n_chunks = int(_os.environ.get("CONT_NCHUNKS", n_chunks))   # =1 -> regenerate every step (kill open-loop chunk drift)
+    actions = []
+    for _k in range(n_chunks):
+        seq = seq + [ACT_START]
+        # model.forward (training branch) expects input_ids as a list of token-lists (pads + tensorizes internally)
+        with _t.no_grad():
+            model(input_ids=[seq], labels=[[-100] * len(seq)], output_hidden_states=True, training=True, att_mask=True)
+        cp = model._cont_preds[0, -1].float().cpu().numpy()       # [7] at the action_start
+        arm = _np.clip(cp[:6], -1.0, 1.0)
+        grip = 2.0 * (1.0 / (1.0 + _np.exp(-cp[6]))) - 1.0        # gripper: BCE logit -> prob -> [-1,1]
+        act_norm = _np.concatenate([arm, [grip]]).astype(_np.float32)
+        actions.append(_t.tensor(act_norm))
+        dims = (_np.digitize(act_norm, bins) + ACT_START + 1).tolist()   # same discretization as process_action
+        seq = seq + dims + [ACT_END]
+    return actions
+
+
+def get_action_Chameleon_cont_awm_ck_cached(model, cur_img, task_description, item_processor,
+                                            his_img, his_action, his_type, action_steps, n_chunks=25):
+    """KV-CACHED open-loop chunked continuous-action decode — drop-in faster replacement for
+    get_action_Chameleon_cont_awm_ck. Instead of re-running the WHOLE growing sequence (incl. the
+    image-heavy prompt) per chunk, this PREFILLS prompt+images+first action_start once (use_cache=True,
+    fresh DynamicCache, cache_position[0]==0 which RESETS the KDA recurrent state), reads the cont head
+    at the action_start -> action 0, then for each subsequent chunk INCREMENTALLY appends the discretized
+    action tokens + action_end + next action_start (advancing cache_position; KDA carries its O(1)
+    recurrent state, full-attn layers reuse cached K/V) and reads the cont head at the new action_start.
+
+    Attention masking faithfully replicates model.generate_att_mask_3 (the training-time mask): each
+    action block masks ALL previous action blocks for the FULL-ATTENTION layers, while the KDA layers are
+    a pure causal recurrence that ignores the mask (see module_videowm/kda_llama.py). We rebuild this per
+    step with a 4D additive mask from per-position block ids (-1=prompt, k=action block k): query i
+    attends key j iff j<=i (causal) AND (block(j)==-1 OR block(j)==block(i)). For the read position
+    (an action_start) this means it sees only prompt+images+itself in the full-attn layers — exactly the
+    full-seq path. Returns list of [7] normalized action tensors (eval's unnorm_min_max denorms). bf16
+    chunk_kda(prefill)-vs-fused_recurrent_kda(decode) rounding => ~1-2% action deviation vs the slow path
+    (validated in test_cont_cache.py)."""
+    import numpy as _np, torch as _t, os as _os
+    from transformers import DynamicCache
+    if his_type == "2h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>" * len(his_img[-1:]) + "<|image|>"
+        imgs = his_img[-1:] + [cur_img]
+    elif his_type == "1h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>"
+        imgs = [cur_img]
+    elif his_type == "4h_1a_img_only":
+        val = "What action should the robot take to " + task_description + "?" + "<|image|>" * len(his_img[-3:]) + "<|image|>"
+        imgs = his_img[-3:] + [cur_img]
+    else:
+        raise ValueError(f"cont head cached decode: unsupported his_type {his_type}")
+    conv = {"conversations": [{"from": "human", "value": val}], "image": imgs, "action": []}
+    tokens = item_processor.process_item(conv, training_mode=False)
+    ACT_START = item_processor.token2id(item_processor.action_start_token)   # 10004
+    ACT_END = item_processor.token2id(item_processor.action_end_token)       # 15004
+    bins = item_processor.bins
+    n_chunks = int(_os.environ.get("CONT_NCHUNKS", n_chunks))
+
+    base = model.model                                  # ChameleonModel (threads use_cache/past_key_values/cache_position)
+    head = model.cont_action_head
+    dev = next(base.parameters()).device
+    dtype = next(base.parameters()).dtype
+    min_dtype = _t.finfo(dtype).min
+    _hd = next(head.parameters()).dtype
+
+    # reset KDA recurrent state on every module (prefill's cache_position[0]==0 also resets, but be explicit)
+    for mod in model.modules():
+        if hasattr(mod, "_kda_state"):
+            mod._kda_state = None
+    pkv = DynamicCache()
+
+    def _mask4d(q_pos, q_blk, all_blk):
+        # q_pos[q] global query positions; q_blk[q] block id of queries; all_blk[kv] block id of all keys
+        kv = all_blk.shape[0]
+        key_idx = _t.arange(kv, device=dev)
+        causal = key_idx[None, :] <= q_pos[:, None]
+        same = (all_blk[None, :] == -1) | (all_blk[None, :] == q_blk[:, None])
+        attend = causal & same
+        m = _t.zeros((q_pos.shape[0], kv), dtype=dtype, device=dev)
+        m.masked_fill_(~attend, min_dtype)
+        return m[None, None]                            # [1,1,q,kv] additive (0=attend, min=mask), max==0
+
+    def _decode_head(out):
+        cp = head(out.last_hidden_state[:, -1].to(_hd))[0].float().cpu().numpy()   # [7] at the action_start
+        arm = _np.clip(cp[:6], -1.0, 1.0)
+        grip = 2.0 * (1.0 / (1.0 + _np.exp(-cp[6]))) - 1.0
+        return _np.concatenate([arm, [grip]]).astype(_np.float32)
+
+    actions = []
+    # ---- prefill: prompt(text+images) + action_start_0 ----
+    seq0 = list(tokens) + [ACT_START]
+    all_blk = _t.tensor([-1] * len(tokens) + [0], device=dev)   # prompt=-1, action_start_0 -> block 0
+    cur_len = len(seq0)
+    q_pos = _t.arange(cur_len, device=dev)
+    with _t.no_grad():
+        out = base(input_ids=_t.tensor([seq0], dtype=_t.int64, device=dev),
+                   attention_mask=_mask4d(q_pos, all_blk, all_blk),
+                   past_key_values=pkv, use_cache=True, cache_position=q_pos,
+                   output_hidden_states=True)
+    act_norm = _decode_head(out)
+    actions.append(_t.tensor(act_norm))
+
+    # ---- incremental decode: append [dims_{k-1}(7), action_end(1), action_start_k(1)] per chunk ----
+    for k in range(1, n_chunks):
+        dims = (_np.digitize(act_norm, bins) + ACT_START + 1).astype(_np.int64).tolist()   # 7 tokens
+        appended = dims + [ACT_END, ACT_START]
+        q_blk = _t.tensor([k - 1] * 8 + [k], device=dev)        # dims+action_end -> block k-1; action_start -> block k
+        all_blk = _t.cat([all_blk, q_blk])
+        q_pos = _t.arange(cur_len, cur_len + 9, device=dev)
+        with _t.no_grad():
+            out = base(input_ids=_t.tensor([appended], dtype=_t.int64, device=dev),
+                       attention_mask=_mask4d(q_pos, q_blk, all_blk),
+                       past_key_values=pkv, use_cache=True, cache_position=q_pos,
+                       output_hidden_states=True)
+        act_norm = _decode_head(out)
+        actions.append(_t.tensor(act_norm))
+        cur_len += 9
+    return actions
