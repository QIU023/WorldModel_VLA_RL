+            self._kd_attn_layers = kset
+            self._student_attn, self._teacher_attn = {}, {}
+
+            def _mk_hook(store, idx):
+                def _hook(module, inp, out):
+                    store[idx] = out[0] if isinstance(out, (tuple, list)) else out
+                return _hook
+
+            # student KDA modules: match by TYPE (FSDP/AttnRes wrapping makes names unreliable -> strict
+            # name regex matched 0). The KDAttention instances survive wrapping; extract layer idx from name.
+            from kda_llama import KDAttention
+            lpat = re.compile(r"layers\.(\d+)\.")
+            ns = 0
+            for name, mod in self.model.named_modules():
+                if isinstance(mod, KDAttention):
+                    m = lpat.search(name)
+                    if m and int(m.group(1)) in kset:
+                        mod.register_forward_hook(_mk_hook(self._student_attn, int(m.group(1))))
+                        ns += 1
+            # teacher (plain replicated softmax model, not FSDP): match self_attn by name
+            tpat = re.compile(r"layers\.(\d+)\.(?:.*\.)?self_attn$")
+            nt = 0
+            for name, mod in teacher.named_modules():
+                m = tpat.search(name)
+                if m and int(m.group(1)) in kset:
+                    mod.register_forward_hook(_mk_hook(self._teacher_attn, int(m.group(1))))
+                    nt += 1
+            self.logger.info(f"[distill] ARL2 attn-output hooks: student {ns}, teacher {nt} (kset {len(kset)})")
+        return teacher
+
