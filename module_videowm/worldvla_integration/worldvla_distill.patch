+    def build_teacher(self):
+        """Lazily build the frozen SDPA teacher (replicated full model on the local device, no FSDP,
+        no optimizer/grad). ~14GB/GPU bf16. Called once on the first distillation train step."""
+        dev = next(self.model.parameters()).device
+        teacher = ChameleonXLLMXForConditionalGeneration_ck.from_pretrained(
+            self.args.teacher_ckpt,
+            max_position_embeddings=self.args.max_seq_len,
+            mask_image_logits=self.args.mask_image_logits,
